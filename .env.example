# Copy to .env (make setup does this). .env is git-ignored; never commit secrets.

# Required. Callers send it in the X-API-Key header on /v1 routes.
API_KEY=dev-api-key

# Address the HTTP server binds to.
LISTEN_ADDR=:8080

# Host port for the compose postgres service. Change it (and the port in
# DATABASE_URL) if 5432 is already in use.
POSTGRES_PORT=5432

# Required. Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler?sslmode=disable

# Start-time grid step (assumption A7). Must be whole minutes dividing a day.
SLOT_GRANULARITY=15m

# OTLP gRPC endpoint for traces. Leave empty to disable export.
# With COMPOSE_PROFILES=observability the collector listens on localhost:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=
