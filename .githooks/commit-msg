#!/usr/bin/env bash
# Enforces Conventional Commits and the 50/72 rule:
#   - subject: <type>[(scope)][!]: <description>, 72 characters at most
#     (a warning above 50), no trailing period
#   - a blank line between subject and body
#   - body lines wrapped at 72 (trailers and lines with URLs are exempt)
set -euo pipefail

msg_file="$1"
# Drop comment lines and everything below git's scissors line.
msg="$(sed -e '/^# -\{8,\} >8 -\{8,\}$/,$d' -e '/^#/d' "$msg_file")"
subject="$(printf '%s\n' "$msg" | sed -n '1p')"

fail() {
	printf 'commit-msg: %s\n' "$1" >&2
	printf '  subject: %s\n' "$subject" >&2
	exit 1
}

# Merge, revert and autosquash commits are generated by git; let them through.
case "$subject" in
Merge\ * | Revert\ * | fixup!\ * | squash!\ * | amend!\ *) exit 0 ;;
esac

types='feat|fix|chore|ci|docs|refactor|perf|test|style|build|revert'
if ! printf '%s' "$subject" | grep -Eq "^($types)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^ ].*$"; then
	fail "subject must follow Conventional Commits: <type>[(scope)][!]: <description> (types: ${types//|/, })"
fi

len=${#subject}
if ((len > 72)); then
	fail "subject is $len characters; the hard limit is 72 (aim for 50)"
elif ((len > 50)); then
	printf 'commit-msg: warning: subject is %d characters; aim for 50 or fewer\n' "$len" >&2
fi
case "$subject" in
*.) fail "subject must not end with a period" ;;
esac

line2="$(printf '%s\n' "$msg" | sed -n '2p')"
if [ -n "$line2" ]; then
	fail "leave one blank line between the subject and the body"
fi

lineno=0
while IFS= read -r line; do
	lineno=$((lineno + 1))
	((lineno <= 2)) && continue
	((${#line} <= 72)) && continue
	# Trailers (Token: value) and lines carrying URLs cannot be wrapped.
	if printf '%s' "$line" | grep -Eq '^[A-Za-z][A-Za-z-]*: |://'; then
		continue
	fi
	fail "body line $lineno is ${#line} characters; wrap the body at 72"
done <<<"$msg"
